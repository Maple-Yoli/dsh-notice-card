{
  "name": "dsh-notice-card",
  "version": "0.1.8",
  "description": "在屏幕右下角弹出通知卡：任务跑完、等你审批、等你回答的时候提醒你一下，卡片不抢焦点。A notice card for DeepSeek Harness on Windows: it appears in the bottom-right corner when a turn ends, or when DSH is waiting for an approval or an answer.",
  "type": "module",
  "main": "lib/index.mjs",
  "exports": {
    ".": {
      "default": "./lib/index.mjs"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "assets",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "compatibility": {
      "dsh": ">=0.1.0-rc.1"
    }
  },
  "dshhub": {
    "schemaVersion": 1,
    "displayName": "Notice Card",
    "summary": "任务跑完、等你审批、等你回答的时候，在屏幕右下角弹一张卡提醒你，不抢焦点。",
    "categories": [
      "通知",
      "桌面"
    ],
    "surfaces": [
      "host"
    ],
    "capabilities": {
      "provides": []
    },
    "compatibility": {
      "dsh": ">=0.1.0-rc.1",
      "node": ">=20"
    },
    "permissions": {
      "network": []
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Maple-Yoli/dsh-notice-card.git"
  },
  "homepage": "https://github.com/Maple-Yoli/dsh-notice-card#readme",
  "bugs": {
    "url": "https://github.com/Maple-Yoli/dsh-notice-card/issues"
  },
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "notification",
    "notify",
    "toast",
    "windows",
    "desktop"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "os": [
    "win32"
  ]
}
