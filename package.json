{
  "name": "dsh-notice-card",
  "version": "0.2.1",
  "description": "Windows 桌面端专用，没有网页端那一半。在屏幕角落弹出通知卡：任务跑完、等你审批、等你回答的时候提醒你一下。跟随系统深浅色与 DPI，落在鼠标那块屏幕，文字用 GDI ClearType 绘制，不抢焦点。Windows desktop only, no web build: a notice card that appears in a corner of the monitor under your pointer when a turn ends, or when DSH is waiting for an approval or an answer. Follows the system theme and DPI, draws text with GDI ClearType, and never takes focus.",
  "type": "module",
  "main": "lib/index.mjs",
  "exports": {
    ".": {
      "default": "./lib/index.mjs"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "assets",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "compatibility": {
      "dsh": ">=0.1.0-rc.1"
    }
  },
  "dshhub": {
    "schemaVersion": 1,
    "displayName": "Notice Card",
    "summary": "任务跑完、等你审批、等你回答的时候，在屏幕角落弹一张卡提醒你。Windows 桌面端专用，不提供网页端通知。跟随系统主题、DPI 与文本大小，落在鼠标那块屏幕，不抢焦点。",
    "categories": [
      "通知",
      "桌面"
    ],
    "surfaces": [
      "host"
    ],
    "capabilities": {
      "provides": []
    },
    "compatibility": {
      "dsh": ">=0.1.0-rc.1",
      "node": ">=20"
    },
    "permissions": {
      "network": []
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Maple-Yoli/dsh-notice-card.git"
  },
  "homepage": "https://github.com/Maple-Yoli/dsh-notice-card#readme",
  "bugs": {
    "url": "https://github.com/Maple-Yoli/dsh-notice-card/issues"
  },
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "notification",
    "notify",
    "toast",
    "windows",
    "desktop",
    "desktop-only",
    "windows-desktop",
    "native-window"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "os": [
    "win32"
  ]
}
